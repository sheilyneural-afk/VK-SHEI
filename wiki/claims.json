      "pattern": "mslim.local_release/v3",
      "meaning": "the local release schema is documented"
    },
    {
      "id": "approximation.disabled",
      "source": "docs/VALIDATION.md",
      "pattern": "epsilon > 0",
      "meaning": "non-zero approximation remains explicitly bounded"
    }
