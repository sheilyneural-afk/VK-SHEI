# Todas las rutas deben permanecer dentro de deploy/local-production/runtime.
MSLIM_ENV=local-production
MSLIM_HOST=127.0.0.1
MSLIM_PORT=8088
MSLIM_WORKER_PORT=8188
MSLIM_WORKER_ENDPOINT=http://127.0.0.1:8188
MSLIM_GATEWAY_TOKEN=REPLACE_WITH_LOCAL_SECRET
MSLIM_BACKEND=auto
# Optional: verified runtime manifest for this platform.
MSLIM_RUNTIME_MANIFEST=
MSLIM_ENABLE_LOD=true
MSLIM_LOD_EPSILON=0
MSLIM_LOD_STAGE_TOKENS=64
MSLIM_PREFILL_BATCH_TOKENS=128
MSLIM_PREFILL_WEIGHT_REUSE_TOKENS=8
MSLIM_HOT_V_TOKENS=512
MSLIM_VERIFIED_PROMPT_REPLAY_TOKENS=8192
MSLIM_VERIFIED_SHARED_PREFIX=true
MSLIM_MICRO_HOT_V_TOKENS=0
MSLIM_DECODE_UNROLL4=true
MSLIM_DEFERRED_COLD=true
MSLIM_FUSED_DECODE=true
MSLIM_EXACT_HOT_FUSED_ATTENTION=true
MSLIM_COLDSTORE_FORMAT=TSKVPG04
MSLIM_MAX_CONTEXT_TOKENS=32768
MSLIM_MAX_NEW_TOKENS=512
MSLIM_REQUEST_TIMEOUT_SECS=300
MSLIM_MAX_IN_FLIGHT=1
MSLIM_MODEL_DIGEST=REPLACE_WITH_SHA256
MSLIM_BINARY_DIGEST=REPLACE_WITH_SHA256
MSLIM_WORKER_BINARY_DIGEST=REPLACE_WITH_SHA256
MSLIM_MODEL_DIR=deploy/local-production/runtime/models/REPLACE_WITH_MODEL_DIGEST
MSLIM_COLDSTORE_DIR=deploy/local-production/runtime/coldstore/default
MSLIM_RECEIPTS_DIR=deploy/local-production/runtime/receipts
MSLIM_LOG_DIR=deploy/local-production/runtime/logs
