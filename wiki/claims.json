      "meaning": "M-SLIM is the visible product identity"
    },
    {
      "id": "validation.matrix.v2",
      "source": "src/project_identity.rs",
      "pattern": "mslim.validation-matrix/v2",
      "meaning": "the active validation matrix schema is defined by the product identity contract"
    },
    {
      "id": "calibration.receipt.v4",
      "source": "src/project_identity.rs",
      "pattern": "mslim.calibration_receipt/v4",
      "meaning": "the active calibration receipt schema is defined by the product identity contract"
    },
    {
      "id": "calibration.kernel.selection",
      "source": "docs/ADAPTIVE_CALIBRATION.md",
