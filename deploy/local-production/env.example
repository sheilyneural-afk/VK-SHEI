# Todas las rutas deben permanecer dentro de deploy/local-production/runtime.
KVSLIM_ENV=local-production
KVSLIM_HOST=127.0.0.1
KVSLIM_PORT=8088
KVSLIM_WORKER_PORT=8188
KVSLIM_WORKER_ENDPOINT=http://127.0.0.1:8188
KVSLIM_GATEWAY_TOKEN=REPLACE_WITH_LOCAL_SECRET
KVSLIM_BACKEND=auto
KVSLIM_ENABLE_LOD=true
KVSLIM_LOD_EPSILON=0
KVSLIM_LOD_STAGE_TOKENS=64
KVSLIM_PREFILL_BATCH_TOKENS=128
KVSLIM_PREFILL_WEIGHT_REUSE_TOKENS=8
KVSLIM_HOT_V_TOKENS=512
KVSLIM_VERIFIED_PROMPT_REPLAY_TOKENS=8192
KVSLIM_VERIFIED_SHARED_PREFIX=true
KVSLIM_MICRO_HOT_V_TOKENS=0
KVSLIM_DECODE_UNROLL4=true
KVSLIM_DEFERRED_COLD=true
KVSLIM_FUSED_DECODE=true
KVSLIM_EXACT_HOT_FUSED_ATTENTION=true
KVSLIM_COLDSTORE_FORMAT=TSKVPG04
KVSLIM_MAX_CONTEXT_TOKENS=32768
KVSLIM_MAX_NEW_TOKENS=512
KVSLIM_REQUEST_TIMEOUT_SECS=300
KVSLIM_MAX_IN_FLIGHT=1
KVSLIM_MODEL_DIGEST=REPLACE_WITH_SHA256
KVSLIM_BINARY_DIGEST=REPLACE_WITH_SHA256
KVSLIM_WORKER_BINARY_DIGEST=REPLACE_WITH_SHA256
KVSLIM_MODEL_DIR=deploy/local-production/runtime/models/REPLACE_WITH_MODEL_DIGEST
KVSLIM_COLDSTORE_DIR=deploy/local-production/runtime/coldstore/default
KVSLIM_RECEIPTS_DIR=deploy/local-production/runtime/receipts
KVSLIM_LOG_DIR=deploy/local-production/runtime/logs
